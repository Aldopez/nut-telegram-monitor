#!/bin/sh

CONFIG="${NUT_TELEGRAM_CONFIG:-/etc/nut/telegram.conf}"
NOTIFICADOR="${NUT_TELEGRAM_NOTIFIER:-/usr/local/bin/notificar-ups-telegram}"
ULTIMO_AVISO="${NUT_TELEGRAM_STATE_FILE:-/run/nut/telegram-battery-last}"
ESTADO_COMUNICACION="${NUT_TELEGRAM_COMM_STATE_FILE:-/run/nut/telegram-communication-state}"
UPSC="${NUT_TELEGRAM_UPSC:-/usr/bin/upsc}"
LOGGER="${NUT_TELEGRAM_LOGGER:-/usr/bin/logger}"
DATE="${NUT_TELEGRAM_DATE:-/usr/bin/date}"

if [ ! -r "$CONFIG" ]; then
    "$LOGGER" -t ups-history \
        "error=no_se_pudo_leer_config archivo=$CONFIG"
    exit 1
fi

# shellcheck source=/dev/null
. "$CONFIG"

UPS_TARGET="${UPS_TARGET:-ups@127.0.0.1}"
INTERVALO_AVISO="${INTERVALO_AVISO:-600}"
RETARDO_COMUNICACION="${RETARDO_COMUNICACION:-600}"
UPS_MOSTRADA="${NOMBRE_UPS:-$UPS_TARGET}"

case "$INTERVALO_AVISO" in
    ''|*[!0-9]*)
        "$LOGGER" -t ups-history \
            "error=intervalo_invalido valor=$INTERVALO_AVISO"
        exit 1
        ;;
esac

case "$RETARDO_COMUNICACION" in
    ''|*[!0-9]*)
        "$LOGGER" -t ups-history \
            "error=retardo_comunicacion_invalido valor=$RETARDO_COMUNICACION"
        exit 1
        ;;
esac

if [ ! -x "$NOTIFICADOR" ]; then
    "$LOGGER" -t ups-history \
        "error=notificador_no_ejecutable archivo=$NOTIFICADOR"
    exit 1
fi

guardar_estado_comunicacion() {
    if ! printf '%s %s\n' "$1" "$2" >"$ESTADO_COMUNICACION"; then
        "$LOGGER" -t ups-history \
            "error=no_se_pudo_guardar_estado archivo=$ESTADO_COMUNICACION"
        return 1
    fi
}

registrar_fallo_comunicacion() {
    AHORA=$("$DATE" +%s 2>/dev/null) || {
        "$LOGGER" -t ups-history \
            "error=no_se_pudo_obtener_fecha"
        return 1
    }

    case "$AHORA" in
        ''|*[!0-9]*)
            "$LOGGER" -t ups-history \
                "error=fecha_invalida valor=$AHORA"
            return 1
            ;;
    esac

    DESDE=
    AVISADO=
    ESTADO_NUEVO=0

    if [ -r "$ESTADO_COMUNICACION" ]; then
        read -r DESDE AVISADO <"$ESTADO_COMUNICACION"
    else
        ESTADO_NUEVO=1
    fi

    case "$DESDE" in
        ''|*[!0-9]*)
            ESTADO_NUEVO=1
            ;;
    esac

    case "$AVISADO" in
        0|1)
            ;;
        *)
            ESTADO_NUEVO=1
            ;;
    esac

    if [ "$ESTADO_NUEVO" -eq 1 ] ||
        [ "$AHORA" -lt "$DESDE" ]
    then
        DESDE=$AHORA
        AVISADO=0
        guardar_estado_comunicacion "$DESDE" "$AVISADO" ||
            return 1
    fi

    if [ "$AVISADO" -eq 1 ] ||
        [ "$((AHORA - DESDE))" -lt "$RETARDO_COMUNICACION" ]
    then
        return 0
    fi

    if NOTIFYTYPE=COMMBAD UPSNAME="$UPS_MOSTRADA" \
        "$NOTIFICADOR"
    then
        guardar_estado_comunicacion "$DESDE" 1 || return 1
        "$LOGGER" -t ups-history \
            "comunicacion=perdida aviso=enviado ups=$UPS_TARGET"
        return 0
    fi

    "$LOGGER" -t ups-history \
        "error=no_se_pudo_notificar_comunicacion ups=$UPS_TARGET"
    return 1
}

procesar_recuperacion_comunicacion() {
    [ -e "$ESTADO_COMUNICACION" ] || return 0

    if [ ! -r "$ESTADO_COMUNICACION" ]; then
        "$LOGGER" -t ups-history \
            "error=no_se_pudo_leer_estado archivo=$ESTADO_COMUNICACION"
        return 1
    fi

    DESDE=
    AVISADO=
    read -r DESDE AVISADO <"$ESTADO_COMUNICACION"

    if [ "$AVISADO" = 1 ]; then
        if ! NOTIFYTYPE=COMMOK UPSNAME="$UPS_MOSTRADA" \
            "$NOTIFICADOR"
        then
            "$LOGGER" -t ups-history \
                "error=no_se_pudo_notificar_recuperacion ups=$UPS_TARGET"
            return 1
        fi

        "$LOGGER" -t ups-history \
            "comunicacion=recuperada aviso=enviado ups=$UPS_TARGET"
    else
        "$LOGGER" -t ups-history \
            "comunicacion=recuperada aviso=omitido ups=$UPS_TARGET"
    fi

    /usr/bin/rm -f "$ESTADO_COMUNICACION"
}

if ! DATOS=$("$UPSC" "$UPS_TARGET" 2>/dev/null); then
    "$LOGGER" -t ups-history \
        "error=no_se_pudo_consultar ups=$UPS_TARGET"

    if [ "${1:-}" = "startup" ]; then
        exit 1
    fi

    registrar_fallo_comunicacion
    exit $?
fi

if [ "${1:-}" != "startup" ]; then
    procesar_recuperacion_comunicacion || true
fi

ESTADO=$(printf '%s\n' "$DATOS" |
    /usr/bin/awk -F': ' '$1 == "ups.status" {print $2}')

CARGA=$(printf '%s\n' "$DATOS" |
    /usr/bin/awk -F': ' '$1 == "battery.charge" {print $2}')

AUTONOMIA=$(printf '%s\n' "$DATOS" |
    /usr/bin/awk -F': ' '$1 == "battery.runtime" {print $2}')

CONSUMO=$(printf '%s\n' "$DATOS" |
    /usr/bin/awk -F': ' '$1 == "ups.load" {print $2}')

case "$AUTONOMIA" in
    ''|*[!0-9]*)
        AUTONOMIA_TEXTO="desconocida"
        ;;
    *)
        HORAS=$((AUTONOMIA / 3600))
        MINUTOS=$(((AUTONOMIA % 3600) / 60))
        AUTONOMIA_TEXTO="${HORAS} h ${MINUTOS} min"
        ;;
esac

"$LOGGER" -t ups-history \
    "status=${ESTADO:-desconocido} charge=${CARGA:-?}% runtime=${AUTONOMIA:-?}s load=${CONSUMO:-?}%"

DETALLE="Estado: ${ESTADO:-desconocido}
Batería: ${CARGA:-?} %
Autonomía estimada: $AUTONOMIA_TEXTO
Carga de la UPS: ${CONSUMO:-?} %"

if [ "${1:-}" = "startup" ]; then
    NOTIFYTYPE=STARTUP UPSNAME="$UPS_MOSTRADA" \
        "$NOTIFICADOR" "El equipo se inició correctamente.
$DETALLE"
    exit $?
fi

case " $ESTADO " in
    *" OB "*)
        AHORA=$(/usr/bin/date +%s)
        ULTIMO=0

        if [ -r "$ULTIMO_AVISO" ]; then
            ULTIMO=$(/usr/bin/sed -n '1p' "$ULTIMO_AVISO")
        fi

        case "$ULTIMO" in
            ''|*[!0-9]*)
                ULTIMO=0
                ;;
        esac

        if [ "$((AHORA - ULTIMO))" -ge "$INTERVALO_AVISO" ]; then
            if NOTIFYTYPE=BATTERY UPSNAME="$UPS_MOSTRADA" \
                "$NOTIFICADOR" "$DETALLE"
            then
                printf '%s\n' "$AHORA" >"$ULTIMO_AVISO"
            fi
        fi
        ;;
    *)
        /usr/bin/rm -f "$ULTIMO_AVISO"
        ;;
esac